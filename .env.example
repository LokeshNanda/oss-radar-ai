GITHUB_TOKEN=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
RADAR_LOG_LEVEL=INFO
RADAR_DOCS_DIR=docs
RADAR_STATE_DIR=.radar_state
RADAR_MAX_REPOS_PER_RUN=10

# --- Radar scope (fork-your-own-radar) ---
# Extra GitHub search qualifiers appended to the weekly query, e.g.:
#   RADAR_SEARCH_QUERY=topic:rust language:rust
#   RADAR_SEARCH_QUERY=topic:ai language:python
#   RADAR_SEARCH_QUERY=topic:security
RADAR_SEARCH_QUERY=
RADAR_SITE_NAME=
RADAR_SITE_DESCRIPTION=
RADAR_SITE_URL=https://lokeshnanda.github.io/oss-radar-ai/

# --- Tuning ---
RADAR_STAR_REFRESH_LIMIT=50
RADAR_README_MAX_CHARS=16000

# --- Alternative OpenAI-compatible providers ---
# OpenRouter:  OPENAI_BASE_URL=https://openrouter.ai/api/v1   OPENAI_MODEL=openai/gpt-4o-mini
# Groq:        OPENAI_BASE_URL=https://api.groq.com/openai/v1 OPENAI_MODEL=llama-3.3-70b-versatile
# Ollama:      OPENAI_BASE_URL=http://localhost:11434/v1      OPENAI_MODEL=llama3.2
OPENAI_BASE_URL=
